<Project>
  <!--
    Repository-wide defaults.

    Machine-specific settings belong in Directory.Build.local.props, which is gitignored and
    imported here when present. That keeps developer preferences out of the repository, so CI
    and packaging always build with the committed defaults.

    The one most people want is skipping the mobile target frameworks of LibVLCSharp, which
    need the android/ios/macos/tvos workloads and add a lot of build time:

      <Project>
        <PropertyGroup>
          <IncludeMobileTargetFrameworks>false</IncludeMobileTargetFrameworks>
        </PropertyGroup>
      </Project>

    Do not set that in a committed file: a Release build packs LibVLCSharp, and the resulting
    package would silently be missing its Android, iOS, macOS and tvOS assets.
  -->
  <PropertyGroup>
    <!--
      Version of VideoLAN.LibVLC.Mac the samples build against. The macOS nightly package is
      stamped with the day it was built (4.0.0-alpha-20260725 and so on), so a fixed number goes
      stale every time CI publishes. Float to the newest one on the videolan-preview feed instead.

      Pin an exact version here, or pass -p:LibVLCMacPackageVersion=..., for a reproducible build.
    -->
    <LibVLCMacPackageVersion Condition="'$(LibVLCMacPackageVersion)' == ''">4.0.0-alpha-*</LibVLCMacPackageVersion>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />
</Project>
